FROM node:20-bullseye AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY apps/api/package.json ./apps/api/

# Install all dependencies (including devDependencies for build)
RUN npm ci

# Copy source code (tsconfig.json is already included in apps/api/)
COPY apps/api ./apps/api

# Build (from workspace root to ensure proper module resolution)
RUN npm run build -w @kotoba/api

# Production image
FROM node:20-bullseye-slim

WORKDIR /app

# Install only production dependencies
COPY package*.json ./
COPY apps/api/package.json ./apps/api/
RUN npm ci --omit=dev

# Copy built files (dist/catalog-seed is filled by the API build script)
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
RUN test -f /app/apps/api/dist/catalog-seed/openjlpt-n5-vocab.json

# SQLite volume mount point (not the catalog seed)
RUN mkdir -p /app/data

WORKDIR /app/apps/api

EXPOSE 3001

# Use absolute path to be sure
CMD ["node", "/app/apps/api/dist/index.js"]

